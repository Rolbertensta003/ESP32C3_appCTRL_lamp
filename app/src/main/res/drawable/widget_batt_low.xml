<?xml version="1.0" encoding="utf-8"?>
<!-- Battery icon, 24 x 12 dp. The inner fill follows the image level (0 to 10000 = 0 to 100%). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:right="3dp">
        <shape android:shape="rectangle">
            <size android:width="21dp" android:height="12dp"/>
            <solid android:color="#00000000"/>
            <stroke android:width="1.5dp" android:color="@color/w_mute"/>
            <corners android:radius="3dp"/>
        </shape>
    </item>
    <item android:left="22dp" android:top="4dp" android:bottom="4dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/w_mute"/>
            <corners android:radius="1dp"/>
        </shape>
    </item>
    <item android:left="3dp" android:top="3dp" android:bottom="3dp" android:right="6dp">
        <clip android:clipOrientation="horizontal" android:gravity="left">
            <shape android:shape="rectangle">
                <solid android:color="@color/w_bad"/>
                <corners android:radius="1dp"/>
            </shape>
        </clip>
    </item>
</layer-list>
