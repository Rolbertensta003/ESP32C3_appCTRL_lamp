<?xml version="1.0" encoding="utf-8"?>
<!-- One lamp in the All lamps widget. Tap the row to open that lamp in the app. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/row_root"
    android:layout_width="match_parent"
    android:layout_height="44dp"
    android:orientation="horizontal"
    android:gravity="center_vertical">

    <ImageView
        android:id="@+id/row_glow"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:padding="1dp"
        android:background="@drawable/widget_glow_ring"
        android:src="@drawable/widget_glow"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="10dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/row_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/w_ink"
            android:textSize="13sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/row_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/w_mute"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <ImageView
        android:id="@+id/row_batt_icon"
        android:layout_width="18dp"
        android:layout_height="9dp"
        android:layout_marginStart="6dp"
        android:scaleType="fitXY"
        android:src="@drawable/widget_batt"
        android:contentDescription="@null" />

    <TextView
        android:id="@+id/row_batt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="3dp"
        android:textColor="@color/w_mute"
        android:textSize="11sp"
        android:maxLines="1" />

    <ImageView
        android:id="@+id/row_power"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="10dp"
        android:padding="9dp"
        android:background="@drawable/widget_power"
        android:src="@drawable/ic_w_power"
        android:contentDescription="@string/w_power" />
</LinearLayout>
