<?xml version="1.0" encoding="utf-8"?>
<!-- 2x1 Battery widget: icon in a circle, percent, lamp name and voltage. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/b_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="12dp"
    android:background="@drawable/widget_bg">

    <FrameLayout
        android:id="@+id/b_icon_box"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/widget_power">

        <ImageView
            android:id="@+id/b_icon"
            android:layout_width="24dp"
            android:layout_height="12dp"
            android:layout_gravity="center"
            android:scaleType="fitXY"
            android:src="@drawable/widget_batt"
            android:contentDescription="@string/w_open_app" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="10dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/b_pct"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/w_preview_batt"
            android:textColor="@color/w_ink"
            android:textSize="22sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/b_sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/w_preview_batt_sub"
            android:textColor="@color/w_mute"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>
</LinearLayout>
