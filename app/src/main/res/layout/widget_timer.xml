<?xml version="1.0" encoding="utf-8"?>
<!-- 2x2 Timer widget: live countdown of the off (or on) delay, presets and Cancel. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tm_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:padding="14dp"
    android:background="@drawable/widget_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tm_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/w_sleep_timer"
            android:textColor="@color/w_ink"
            android:textSize="14sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <ImageView
            android:id="@+id/tm_batt_icon"
            android:layout_width="18dp"
            android:layout_height="9dp"
            android:scaleType="fitXY"
            android:src="@drawable/widget_batt"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/tm_batt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:text="@string/w_preview_batt"
            android:textColor="@color/w_mute"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tm_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/w_preview_name"
        android:textColor="@color/w_mute"
        android:textSize="12sp"
        android:maxLines="1"
        android:ellipsize="end" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp">

        <Chronometer
            android:id="@+id/tm_count"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/w_ink"
            android:textSize="30sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tm_idle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/w_timer_idle"
            android:textColor="@color/w_ink"
            android:textSize="22sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />
    </FrameLayout>

    <TextView
        android:id="@+id/tm_when"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/w_timer_hint"
        android:textColor="@color/w_mute"
        android:textSize="12sp"
        android:maxLines="1"
        android:ellipsize="end" />

    <LinearLayout
        android:id="@+id/tm_chips"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView android:id="@+id/tm_15" style="@style/WidgetChip" android:layout_marginEnd="4dp" android:text="@string/w_t15" />
        <TextView android:id="@+id/tm_30" style="@style/WidgetChip" android:layout_marginEnd="4dp" android:text="@string/w_t30" />
        <TextView android:id="@+id/tm_60" style="@style/WidgetChip" android:layout_marginEnd="4dp" android:text="@string/w_t60" />
        <TextView android:id="@+id/tm_120" style="@style/WidgetChip" android:layout_marginEnd="0dp" android:text="@string/w_t120" />
    </LinearLayout>

    <TextView
        android:id="@+id/tm_cancel"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:background="@drawable/widget_chip_on"
        android:text="@string/w_timer_cancel"
        android:textColor="@color/w_ink"
        android:textSize="13sp"
        android:visibility="gone" />
</LinearLayout>
