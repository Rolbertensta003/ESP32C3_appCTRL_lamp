<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/t_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="6dp"
    android:background="@drawable/widget_bg">

    <FrameLayout
        android:layout_width="44dp"
        android:layout_height="44dp">

        <ImageView
            android:id="@+id/t_glow"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/widget_glow_ring"
            android:padding="1dp"
            android:src="@drawable/widget_glow"
            android:contentDescription="@null" />

        <ImageView
            android:id="@+id/t_icon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_w_power_on"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/t_batt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:paddingStart="3dp"
            android:paddingEnd="3dp"
            android:background="@drawable/widget_badge"
            android:text="@string/w_preview_batt"
            android:textColor="@color/w_ink"
            android:textSize="8sp"
            android:textStyle="bold"
            android:maxLines="1" />
    </FrameLayout>

    <TextView
        android:id="@+id/t_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:gravity="center"
        android:text="@string/w_preview_name"
        android:textColor="@color/w_ink"
        android:textSize="11sp"
        android:maxLines="1"
        android:ellipsize="end" />
</LinearLayout>
