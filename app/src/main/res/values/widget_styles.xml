<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="WidgetChip">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginEnd">6dp</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/widget_chip</item>
        <item name="android:textColor">@color/w_ink</item>
        <item name="android:textSize">12sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>
    <style name="WidgetStepButton">
        <item name="android:layout_width">32dp</item>
        <item name="android:layout_height">32dp</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/widget_btn</item>
        <item name="android:textColor">@color/w_ink</item>
        <item name="android:textSize">18sp</item>
    </style>
</resources>
